# XRL-IDARS PostgreSQL Database Configuration Template
# Copy this file to .env and adjust variables as required.
# NEVER commit your actual .env file or passwords to version control.

# Database Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xrlids
POSTGRES_USER=xrlids_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5

# Storage Mode:
#   auto: Connect to PostgreSQL if reachable, fallback to memory ring buffer + JSONL if not
#   postgres: Strictly require PostgreSQL; report startup failure if unreachable
#   memory_jsonl: Use in-memory ring buffer + JSONL disk append only (offline development/tests)
#   disabled: In-memory ring buffer only; no disk or database persistence
XRLIDS_STORAGE_MODE=auto

# Audit Logging (retains secondary JSONL export alongside PostgreSQL)
XRLIDS_JSONL_EXPORT=true

# Asynchronous Persistence Queue Tuning
XRLIDS_ASYNC_QUEUE_SIZE=10000
XRLIDS_ASYNC_BATCH_SIZE=100
XRLIDS_ASYNC_FLUSH_INTERVAL_S=0.5
