# .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# Environment / secrets - never commit credentials or environment-specific values
.env
.env.*
*.pem
*.key

# Datasets - large, licensed, and checksum-tracked via data/manifests/dataset_registry.yaml.
# Raw/interim/processed data must NOT be committed; only manifests and splits metadata.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model binaries - generic ignore
*.joblib
*.pt
*.pth
results/**/predictions_test.csv

# Canonical model artifacts tracked for deployment and evaluation
!models/rf/*.joblib
!models/lstm/*.pt
!models/dqn/*.pt
!models/fusion/*.json

# Flagship experiment checkpoints and preprocessors for replay & dashboard
!results/experiments/EXP-P1-CIC2017-R10-001/*.joblib
!results/experiments/EXP-P1-CIC2017-R10-001/*.pt
!results/experiments/EXP-P1-CSE2018-R10-MULTI-001/*.joblib
!results/experiments/EXP-P1-CSE2018-R10-MULTI-001/*.pt
!results/experiments/EXP-P1-UNSWNB15-R10-MULTI-001/*.joblib
!results/experiments/EXP-P1-UNSWNB15-R10-MULTI-001/*.pt
!results/experiments/EXP-P2-LSTM-VALID-001/*.joblib
!results/experiments/EXP-P2-LSTM-VALID-001/*.pt
!results/phase2/EXP-P2B-DQN-001/checkpoints/**/best_model.pt
results/phase2/**/checkpoint_step_*.pt
results/phase2/**/ablation_checkpoints/**

# Generated figures are regenerated from results; generated Markdown reports ARE committed
# so the repository contains readable evidence derived from the result artifacts.
reports/generated/*.png
reports/generated/*.pdf
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png

# Live capture artifacts
*.pcap
!data/demo/sample_traffic.pcap
*.pcapng

# Logs
*.log
logs/

# OS / editor / local tools
.DS_Store
Thumbs.db
.idea/
.vscode/
.freebuff/
