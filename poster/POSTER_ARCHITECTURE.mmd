    classDef detection fill:#b91c1c,stroke:#ef4444,stroke-width:2px,color:#ffffff;
    classDef explain fill:#7c3aed,stroke:#a855f7,stroke-width:2px,color:#ffffff;
    classDef response fill:#047857,stroke:#10b981,stroke-width:2px,color:#ffffff;
    classDef safety fill:#b45309,stroke:#f59e0b,stroke-width:2px,color:#ffffff;
    classDef telemetry fill:#0f172a,stroke:#64748b,stroke-width:2px,color:#ffffff;
    classDef research fill:#334155,stroke:#94a3b8,stroke-width:1.5px,color:#cbd5e1,stroke-dasharray: 5 5;

    class WIRE,PCAP,INGEST,CANON,FLOW_TAB,EXPIRY,EXTRACT,SCALER operational;
    class RF,SCORE,EVENT detection;
    class SHAP,WATERFALL explain;
    class BUILDER,STATE,DQN,QVALS,PROPOSED response;
    class SG_CRIT,SG_BLAST,SG_COOL,OVER_CRIT,OVER_BLAST,OVER_COOL,PASS_ACT,ENFORCED safety;
    class ACTUATOR,AUDIT,STREAMLIT telemetry;
    class LSTM_BUF,LSTM,FUSION research;
